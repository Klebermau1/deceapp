<!DOCTYPE html>
<html lang="es">
    <head>
        <%- include('../partials/head') %>

        <style>
            .auth-slide { animation: authKenBurns 18s ease-in-out infinite; }
            @keyframes authKenBurns {
                0%   { transform: scale(1); }
                50%  { transform: scale(1.08); }
                100% { transform: scale(1); }
            }
            .login-logo-badge { animation: loginLogoPop .6s cubic-bezier(.34, 1.56, .64, 1); }
            .login-logo-badge::before {
                content: '';
                position: absolute;
                inset: -10px;
                border-radius: 9999px;
                border: 2px solid rgba(79, 70, 229, .3);
                animation: loginLogoPulse 2.6s ease-out infinite;
            }
            @keyframes loginLogoPop {
                0%   { transform: scale(.5); opacity: 0; }
                100% { transform: scale(1); opacity: 1; }
            }
            @keyframes loginLogoPulse {
                0%   { transform: scale(1);   opacity: .55; }
                100% { transform: scale(1.35); opacity: 0; }
            }
        </style>
        <%- style %>
    </head>
    <body class="font-sans text-gray-900 antialiased">
        <div class="relative min-h-screen flex flex-col lg:flex-row">

            <!-- Panel derecho: login -->
            <div class="w-full lg:w-2/5 flex flex-col items-center justify-center px-6 py-12 bg-white order-2 lg:order-2">
                <div class="w-full sm:max-w-sm mt-12 lg:mt-0">
                    <div class="text-center mb-8">
                        <div class="login-logo-badge relative w-28 h-28 mx-auto rounded-full bg-white flex items-center justify-center p-4 border-4 border-indigo-50 shadow-[0_12px_32px_rgba(79,70,229,0.22)]">
                            <%- include('../components/institution-logo', { clase: 'max-w-full max-h-full w-auto h-auto object-contain fill-current text-indigo-600' }) %>
                        </div>

                        <h4 class="mt-5 text-lg font-bold text-gray-800">Bienvenido 👋</h4>
                        <p class="mt-1 text-sm text-gray-500">
                            Ingresa tus credenciales para acceder al portal de <%= nombreInstitucion %>
                        </p>
                    </div>

                    <%- body %>
                </div>

                <footer class="mt-10 lg:mt-auto lg:pt-10 text-center">
                    <small class="text-xs text-gray-400">
                        &copy; <%= anio %> <%= nombreInstitucion %> &middot; Acceso restringido al personal autorizado
                    </small>
                </footer>
            </div>

            <!-- Panel izquierdo: carrusel de imágenes -->
            <div class="hidden lg:flex relative lg:w-3/5 overflow-hidden bg-slate-900 order-1 lg:order-1"
                 x-data="{
                    images: ['/assets/img/fondo-arbol.jpg', '/assets/img/login-fondo.jpg'],
                    current: 0,
                 }"
                 x-init="setInterval(() => current = (current + 1) % images.length, 6000)">

                <template x-for="(img, i) in images" :key="i">
                    <div class="auth-slide absolute inset-0 bg-cover bg-center transition-opacity duration-[1400ms] ease-in-out"
                         :class="current === i ? 'opacity-100 z-[1]' : 'opacity-0'"
                         :style="`background-image: url('${img}')`">
                    </div>
                </template>

                <div class="absolute inset-0 z-[2]" style="background: linear-gradient(180deg, rgba(8,16,28,.25) 0%, rgba(8,16,28,.05) 40%, rgba(8,16,28,.85) 100%);"></div>

                <a href="/" class="absolute z-[3] top-6 left-6 inline-flex items-center gap-2 rounded-lg px-3 py-2 bg-slate-900/40 backdrop-blur border border-white/10">
                    <%- include('../components/institution-logo', { clase: 'h-7 w-auto object-contain drop-shadow' }) %>
                    <span class="text-white font-bold text-sm drop-shadow"><%= nombreInstitucion %></span>
                </a>

                <div class="absolute z-[3] left-0 right-0 bottom-16 px-14">
                    <h2 class="text-white font-bold text-2xl mb-2"><%= nombreInstitucion %></h2>
                    <p class="text-white/75">Departamento de Consejería Estudiantil</p>
                </div>

                <div class="absolute z-[3] bottom-8 left-0 right-0 flex justify-center gap-2">
                    <template x-for="(img, i) in images" :key="i">
                        <button type="button"
                                @click="current = i"
                                class="h-2 rounded-full transition-all"
                                :class="current === i ? 'bg-white w-6' : 'bg-white/45 w-2'"></button>
                    </template>
                </div>
            </div>
        </div>

        <%- include('../components/loading-overlay') %>
        <%- script %>
    </body>
</html>
