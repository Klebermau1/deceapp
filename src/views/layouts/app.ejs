<!DOCTYPE html>
<html lang="es">
    <head>
        <%- include('../partials/head') %>
        <%- style %>
    </head>
    <body class="font-sans antialiased">
        <div class="min-h-screen bg-gray-100">
            <%- include('../partials/navigation') %>

            <% if (locals.header) { %>
