<%- contentFor('header') %>
<div class="flex items-center justify-between">
    <h2 class="font-semibold text-xl text-gray-800 leading-tight">Usuarios del equipo DECE</h2>
    <a href="<%= route('usuarios.create') %>" class="inline-flex items-center px-4 py-2 bg-gray-800 border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:bg-gray-700">
        + Nuevo usuario
    </a>
</div>

<%- contentFor('body') %>
<div class="py-8">
    <div class="max-w-7xl mx-auto sm:px-6 lg:px-8 space-y-4">

        <%- include('../components/alertas') %>

        <div class="bg-white shadow-sm sm:rounded-lg overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-2 text-left font-medium text-gray-500">Nombre</th>
                        <th class="px-4 py-2 text-left font-medium text-gray-500">Correo</th>
                        <th class="px-4 py-2 text-left font-medium text-gray-500">Cargo</th>
                        <th class="px-4 py-2 text-left font-medium text-gray-500">Rol</th>
                        <th class="px-4 py-2 text-left font-medium text-gray-500">Estado</th>
                        <th class="px-4 py-2"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <% pagina.items.forEach((usuario) => { %>
                        <tr>
                            <td class="px-4 py-2"><%= usuario.name %></td>
                            <td class="px-4 py-2"><%= usuario.email %></td>
                            <td class="px-4 py-2"><%= usuario.cargo %></td>
                            <td class="px-4 py-2"><%= usuario.roles %></td>
                            <td class="px-4 py-2">
                                <span class="<%= f.clases('text-xs font-semibold px-2 py-1 rounded-full', {
                                    'bg-green-100 text-green-700': usuario.activo,
                                    'bg-gray-200 text-gray-600': !usuario.activo,
                                }) %>">
                                    <%= usuario.activo ? 'Activo' : 'Inactivo' %>
                                </span>
                            </td>
                            <td class="px-4 py-2 text-right space-x-2 whitespace-nowrap">
                                <a href="<%= route('usuarios.edit', usuario.id) %>" class="text-indigo-600 hover:underline">Editar</a>
                                <% if (usuario.id !== user.id) { %>
                                    <form action="<%= route('usuarios.destroy', usuario.id) %>" method="POST" class="inline" onsubmit="return confirm('¿Eliminar este usuario?');">
                                        <%- csrf %>
                                        <input type="hidden" name="_method" value="DELETE">
                                        <button type="submit" class="text-red-600 hover:underline">Eliminar</button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <%- include('../partials/paginacion', { pagina }) %>
    </div>
</div>
