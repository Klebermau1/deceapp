# --- Aplicacion ---
APP_NAME="Plataforma DECE"
# production en Hostinger: cookies seguras (HTTPS) y errores sin detalle.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Clave larga y aleatoria para firmar la cookie de sesion. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Minutos de inactividad antes de cerrar la sesion (igual que Laravel).
SESSION_LIFETIME=120

# --- Base de datos principal (MySQL de Hostinger) ---
# Es la MISMA base que usa hoy la version PHP: no hay que migrar datos.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dece_db
DB_USERNAME=dece_app
DB_PASSWORD=

# --- Ficha estudiantil (solo lectura, sistema de matricula) ---
FICHA_DB_HOST=127.0.0.1
FICHA_DB_PORT=3306
FICHA_DB_DATABASE=ficha_estudiantil_db
FICHA_DB_USERNAME=dece_app
FICHA_DB_PASSWORD=

# --- Biometrico (solo lectura, control de asistencia) ---
BIOMETRICO_DB_HOST=127.0.0.1
BIOMETRICO_DB_PORT=3306
BIOMETRICO_DB_DATABASE=biometrico
BIOMETRICO_DB_USERNAME=dece_app
BIOMETRICO_DB_PASSWORD=

# --- Archivos ---
# Carpeta con los archivos subidos (equivale a storage/app/public de
# Laravel: logos/, entrevistas/, etc.). Copiar ahi el contenido actual.
STORAGE_PATH=./storage/public
BIOMETRICO_UPLOADS_PATH=
MATRICULA_UPLOADS_PATH=

# --- Instrumento de aplicacion (acceso publico con clave compartida) ---
INSTRUMENTO_CLAVE_ACCESO=

# --- OpenAI (analisis con IA) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=20
OPENAI_MAX_LLAMADAS_HORA=30
